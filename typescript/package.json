{
  "name": "@polydera/trueform",
  "version": "0.8.2",
  "description": "Real-time geometric processing in TypeScript. WASM-backed NDArrays with vectorized operations, spatial queries, arrangements, booleans, registration, and remeshing — at native speed in the browser and Node.js. Exact and robust. NDArrays in, NDArrays out.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.noncommercial"
  ],
  "keywords": [
    "mesh",
    "geometry",
    "computational-geometry",
    "mesh-processing",
    "mesh-boolean",
    "collision-detection",
    "point-cloud",
    "csg",
    "wasm",
    "ndarray",
    "spatial-queries",
    "isocontours"
  ],
  "homepage": "https://trueform.polydera.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/polydera/trueform",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/polydera/trueform/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Polydera",
    "email": "info@polydera.com",
    "url": "https://polydera.com"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
