@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(TBB CONFIG REQUIRED)

# baked at configure time
set(_trueform_with_mimalloc @TF_USE_MIMALLOC@)
if(_trueform_with_mimalloc)
  find_dependency(mimalloc CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/trueformTargets.cmake")
